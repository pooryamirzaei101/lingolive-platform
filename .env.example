NODE_ENV=development
POSTGRES_DB=lingolive
POSTGRES_USER=lingolive
POSTGRES_PASSWORD=change-this-development-password
DATABASE_URL=postgresql://lingolive:change-this-development-password@postgres:5432/lingolive?schema=public
REDIS_URL=redis://redis:6379
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://api:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
SESSION_COOKIE_NAME=lingolive_session
SESSION_TTL_DAYS=30
PASSWORD_PEPPER=replace-with-a-long-random-secret
EMAIL_TOKEN_TTL_MINUTES=30
RESET_TOKEN_TTL_MINUTES=20
MAIL_FROM=LingoLive <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
